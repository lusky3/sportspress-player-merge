npm-debug.log

# Composer
# composer.lock is committed deliberately (dev-only tooling, pinned for
# reproducible CI installs) — only the installed packages are ignored.
# Anchored to the repo root: an unanchored `vendor/` also matched
# assets/vendor/select2/ (the bundled, deliberately-committed Select2 library)
# for this repo's entire history, silently blackholing it from every `git add`
# — every real release has shipped with a broken admin UI as a result
# (Select2 undefined, both player-picker dropdowns inert) because the vendor
# bundle the code references was never actually in version control.
/vendor/

# Build files
build/
dist/

# Generated coverage output (tests/run-coverage.sh). Anchored to the repo
# root so this doesn't also swallow bin/coverage/ (the scripts that produce it).
/coverage/
/.coverage-raw/

# Environment files
.env
.env.local
.env.production
.playwright-mcp/
.kiro/
.superpowers/

# Local agent state and audit deliverables. Audit reports are handed over at
# the repo root and read there; they are a snapshot of one run, not something
# the repository should carry forward. Matches the rules in
# SportsPress-Admin-Tools.
.claude
.codegraph
AUDIT-REPORT*.md
BRAINSTORM-REPORT.md
