includes:
  - %rootDir%/../../szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 5
  paths:
    - sportspress-player-merge.php
    - classes/
    - includes/
    - uninstall.php
  bootstrapFiles:
    - phpstan-bootstrap.php
  scanFiles:
    - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-stubs.php
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - '#Function apply_filters invoked with#'
    - '#Function do_action invoked with#'
    - '#will always evaluate to (true|false)#'
    - '#result will always#'
    - '#never returns .* so it can be removed#'
    - '#is unused#'
    - '#Parameter .* of function array_filter expects#'
    -
      # includes/admin-page.php is a template, `include_once`'d from inside
      # SP_Merge_Admin::render_admin_page() so `$this` resolves at runtime to
      # that instance. PHPStan analyses the file standalone and can't see the
      # including scope — a false positive inherent to this WordPress
      # template-include pattern, not a real undefined-variable bug.
      message: '#Variable \$this might not be defined#'
      path: includes/admin-page.php
